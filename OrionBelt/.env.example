# =============================================================================
# 🌌 ORION | Optical Recognition & Intelligent Obstacle Navigation
# Plantilla Maestra de Variables de Entorno (.env.example)
# =============================================================================
# Instrucciones:
# 1. Copia este archivo con el nombre '.env' en la raíz del proyecto:
#    En Windows: copy .env.example .env
#    En Mac/Linux: cp .env.example .env
# 2. Ajusta los valores de acuerdo con tu entorno y hardware disponible.
# 3. NOTA DE SEGURIDAD: '.env' está protegido en .gitignore y NUNCA debe ser
#    subido a repositorios públicos o compartirse con credenciales reales.
# =============================================================================

# -----------------------------------------------------------------------------
# 🗂️ 1. SELECCIÓN DE VERSIÓN Y ARRANQUE GENERAL
# -----------------------------------------------------------------------------
# Versión de ORION a ejecutar por defecto al iniciar 'main.py' sin parámetros.
# Opciones disponibles:
#   1 = v1_desktop_initial     (Ventana de escritorio síncrona con OpenCV)
#   2 = v2_desktop_optimized   (Escritorio multihilo con telemetría HUD)
#   3 = v3_web_local           (Servidor Web FastAPI con cámara local USB/integrada)
#   4 = v4_web_esp32           (Servidor Web con ESP32-CAM AI-Thinker)
#   5 = v5_web_xiao_esp32s3    (Servidor Web XIAO ESP32S3 + Hot-Swap a cámara Mac/PC) [RECOMENDADA]
#   6 = v6_mobile_android      (Guía y configuración para App Móvil Nativa en Android)
ORION_VERSION=5

# -----------------------------------------------------------------------------
# 🌐 2. SERVIDOR WEB ASÍNCRONO & DASHBOARD (FastAPI + WebSockets)
# -----------------------------------------------------------------------------
# Dirección IP de enlace para el servidor web:
#   0.0.0.0   -> Permite acceso desde cualquier equipo en la misma red local (LAN/Wi-Fi)
#   127.0.0.1 -> Restringe el acceso exclusivamente a la máquina local (localhost)
ORION_HOST=0.0.0.0

# Puerto TCP en el que se expondrá el panel de control web y los WebSockets
ORION_PORT=8000

# -----------------------------------------------------------------------------
# 📷 3. HARDWARE IOT: Seeed Studio XIAO ESP32S3 Sense (Cinturón / Visor)
# -----------------------------------------------------------------------------
# Dirección IP asignada al microcontrolador en la red Wi-Fi:
#   - Si se deja vacío (XIAO_IP=), el sistema utilizará el motor autónomo de descubrimiento
#     (Faro UDP puerto 9999, caché persistente 'known_xiao_ips.json' y escaneo rápido).
#   - Si se especifica una IP fija, el sistema intentará conectarse prioritariamente a ella.
XIAO_IP=172.16.121.142

# Puerto TCP dedicado para el stream de video MJPEG del XIAO
XIAO_STREAM_PORT=81

# Puerto TCP para la API HTTP de control del microcontrolador (Buzzer, telemetría y ajustes)
XIAO_CTRL_PORT=80

# -----------------------------------------------------------------------------
# 💻 4. CÁMARA LOCAL DE RESPALDO (Mecanismo Autónomo Hot-Swap / Rollback)
# -----------------------------------------------------------------------------
# Fuente de video local para respaldo ante caída o pérdida de señal del XIAO:
#   0 = Primera cámara web disponible (integrada en laptops / Mac)
#   1 = Segunda cámara USB conectada
#   También admite URLs RTSP o archivos de video para pruebas sintéticas.
FALLBACK_SRC=0

# -----------------------------------------------------------------------------
# 🧠 5. INTELIGENCIA ARTIFICIAL & ESTIMACIÓN DE PROFUNDIDAD (MiDaS)
# -----------------------------------------------------------------------------
# Dispositivo de aceleración para la red neuronal:
#   auto = Detección automática (prioriza CUDA > MPS > CPU)
#   cuda = Tarjeta gráfica dedicada NVIDIA (requiere PyTorch con soporte CUDA)
#   mps  = Aceleración por Metal Performance Shaders en Apple Silicon (Mac M1/M2/M3/M4)
#   cpu  = Procesamiento por procesador central (compatible con cualquier equipo)
DEVICE=auto

# Arquitectura del modelo MiDaS a cargar:
#   MiDaS_small = Diseñado para visión en tiempo real (alta velocidad a 25-30 FPS, ~40MB) [RECOMENDADO]
#   DPT_Hybrid  = Balance entre precisión geométrica y tasa de cuadros por segundo
#   DPT_Large   = Máxima densidad y fidelidad visual (orientado a servidores con GPU potente)
MODEL_TYPE=MiDaS_small

# Ancho de fotograma en píxeles al que se escala la imagen antes de ingresar a la red:
#   320 = Resolución óptima recomendada (equilibrio perfecto entre latencia y agudeza)
#   256 = Modo ultrarrápido para dispositivos con cómputo limitado
#   480 = Mayor definición para pruebas de laboratorio
PROC_WIDTH=320

# Factor de suavizado exponencial temporal (EMA) entre fotogramas consecutivos (0.0 a 1.0):
#   0.0 = Sin suavizado (la salida es directa del fotograma actual, puede parpadear)
#   0.65 = Valor óptimo (elimina parpadeos y fluctuaciones espurias de alta frecuencia)
#   0.90 = Suavizado pesado (muy estable pero introduce leve inercia de movimiento)
TEMPORAL_ALPHA=0.65

# Hilos de cómputo para PyTorch y OpenCV (0 = asignación automática según núcleos del CPU)
TORCH_THREADS=0
CV_THREADS=0

# Frecuencia de liberación de caché de memoria en Apple Silicon (fotogramas)
MPS_EMPTY_CACHE_EVERY=300

# Compatibilidad de operadores Metal en macOS (1 = redirige operadores no soportados a CPU)
PYTORCH_ENABLE_MPS_FALLBACK=1

# -----------------------------------------------------------------------------
# 🚨 6. DETECCIÓN DE OBSTÁCULOS, NAVEGACIÓN Y ALARMAS
# -----------------------------------------------------------------------------
# Umbral relativo de proximidad en el corredor central de avance (0.0 a 1.0):
#   Cuando el obstáculo supera este valor normalizado de cercanía, se detona el estado 'STOP'.
NEAR_THRESHOLD=0.60

# Potencia PWM para el buzzer piezoeléctrico en el XIAO ESP32S3 (rango 0 a 255):
BUZZER_DUTY=200

# Duración del pulso sonoro de advertencia en milisegundos:
BUZZER_DURATION=150

# Habilitar reproducción de alertas sonoras locales en los altavoces de la computadora (true / false):
ENABLE_LOCAL_SOUND=true
