# ==============================================================================
# PROJECTION MAPPER STUDIO - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo con el nombre ".env" en la raíz del proyecto:
#    Windows: copy .env.example .env
#    Linux/macOS: cp .env.example .env
# 2. Modifica los valores según los requerimientos de tu infraestructura o show.
# ==============================================================================

# ------------------------------------------------------------------------------
# RED Y SERVIDOR HTTP LOCAL
# ------------------------------------------------------------------------------
# Puerto TCP en el que se ejecuta el servidor web y la API REST de proyección.
# Si el puerto está ocupado, el script de inicio buscará automáticamente el siguiente.
# Valor por defecto: 8085
PORT=8085

# Dirección IP o interfaz de red de enlace.
# - 127.0.0.1 : Acceso exclusivo desde la máquina local (recomendado por seguridad).
# - 0.0.0.0   : Permite conectar laptops auxiliares, tablets o proyectores en red LAN.
# Valor por defecto: 127.0.0.1
HOST=127.0.0.1

# Entorno de ejecución actual (development | production | portable).
# Valor por defecto: production
APP_ENV=production

# ------------------------------------------------------------------------------
# ALMACENAMIENTO Y RUTAS DE ARCHIVOS
# ------------------------------------------------------------------------------
# Directorio raíz para archivos multimedia subidos por el operador (imágenes y videos).
# Puede ser una ruta relativa al directorio raíz del proyecto o una ruta absoluta.
# Valor por defecto: ./media
MEDIA_DIR=./media

# Directorio donde se guardan y cargan las escenas (.json) y paquetes portables (.pmap).
# Valor por defecto: ./scenes
SCENES_DIR=./scenes

# Directorio de destino para los videos finales pre-mapeados exportados en formato .mp4.
# Valor por defecto: ./media/exports
EXPORTS_DIR=./media/exports

# ------------------------------------------------------------------------------
# MOTOR DE RENDERIZADO Y VIDEO (FFMPEG / GPU)
# ------------------------------------------------------------------------------
# Ruta absoluta o relativa al ejecutable de FFmpeg.
# Si se deja vacío, el sistema busca automáticamente en:
# 1. ./bin/ffmpeg.exe (binario portable local)
# 2. Variable PATH del sistema operativo
# Valor por defecto: (auto-detectado)
# FFMPEG_PATH=C:\ProgramData\chocolatey\bin\ffmpeg.exe

# Sobrescribir el códec de video H.264 para exportación de video pre-mapeado.
# Opciones disponibles:
# - auto       : Detección inteligente de hardware GPU con fallback a CPU (recomendado).
# - h264_nvenc : Aceleración por GPU dedicada NVIDIA.
# - h264_amf   : Aceleración por GPU dedicada AMD Radeon.
# - h264_qsv   : Aceleración por GPU Intel QuickSync Video.
# - h264_mf    : Aceleración nativa Windows Media Foundation.
# - libx264    : Codificación por CPU de alta compatibilidad universal.
# Valor por defecto: auto
FFMPEG_ENCODER_OVERRIDE=auto

# ------------------------------------------------------------------------------
# CONTROL Y EXPERIENCIA DE USUARIO (LANZADOR)
# ------------------------------------------------------------------------------
# Abrir automáticamente el navegador web predeterminado al iniciar el servidor.
# Valores aceptados: true | false
# Valor por defecto: true
AUTO_OPEN_BROWSER=true

# Modo de depuración (muestra trazas detalladas y logs HTTP en la consola).
# Valores aceptados: true | false
# Valor por defecto: false
DEBUG=false
